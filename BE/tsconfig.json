{
  "compilerOptions": {
    "target": "ES2022",
  "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "types": ["aws-lambda"],
    "outDir": "dist-types"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
